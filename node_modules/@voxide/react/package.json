{
  "name": "@voxide/react",
  "version": "0.8.0",
  "description": "Capability-first voice AI SDK for the web. Register your JavaScript functions and let a live voice agent call them when users speak or type.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    },
    "./browser": "./dist/voxide.browser.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "INTEGRATION_GUIDE.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "node scripts/build-shader.mjs && node scripts/verify-uniforms.mjs && tsup && node scripts/check-core.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public",
    "build:shader": "node scripts/build-shader.mjs",
    "check:shader": "node scripts/build-shader.mjs --check",
    "verify:uniforms": "node scripts/verify-uniforms.mjs",
    "preview:orb": "node dev/build-preview.mjs",
    "check:core": "node scripts/check-core.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "framer-motion": "^12",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.72",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "voice",
    "ai",
    "voice-agent",
    "gemini",
    "agent",
    "sdk",
    "voxide",
    "tool-calling",
    "function-calling",
    "react",
    "next"
  ],
  "author": "Voxide",
  "license": "MIT",
  "homepage": "https://voxide.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andymarrow/voxide-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/andymarrow/voxide-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./dist/voxide.browser.js",
  "jsdelivr": "./dist/voxide.browser.js"
}
